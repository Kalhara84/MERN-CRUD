# Copy this file to ".env" and change the values for your PC.
PORT=5000
NODE_ENV=development

# PostgreSQL (same database the Django project used)
DB_NAME=django_test
DB_USER=postgres
DB_PASSWORD=mypass
DB_HOST=localhost
DB_PORT=5432

# Secret used to sign login tokens. Use a long random text in production.
JWT_SECRET=change-this-to-a-long-random-text

# Audit date/time columns use this time zone
TZ_NAME=Asia/Colombo

# Address of the React app (used for CORS when frontend is hosted separately)
CLIENT_URL=http://localhost:5173
APP_NAME=JW Africa
