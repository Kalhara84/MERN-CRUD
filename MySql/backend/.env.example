# Copy this file to ".env" and change the values for your PC.
PORT=5000

# PostgreSQL - create an EMPTY database with this name first
DB_NAME=curd_simple
DB_USER=postgres
DB_PASSWORD=mypass
DB_HOST=localhost
DB_PORT=5432

# Secret used to sign the login token. Use a long random text.
JWT_SECRET=change-this-to-a-long-random-text
